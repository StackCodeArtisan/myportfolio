---
// VendoraCRM's real production architecture, drawn as a blueprint.
const core = [
  { y: 24, title: 'Customers and business owners', sub: 'Storefront, checkout and dashboard' },
  { y: 134, title: 'Vue.js frontend', sub: 'Deployed on Vercel' },
  { y: 244, title: 'FastAPI REST API', sub: 'Deployed on Render', key: true },
  { y: 354, title: 'PostgreSQL', sub: 'SQLAlchemy models, Alembic migrations' },
];
const services = [
  { y: 186, title: 'Paystack', sub: 'Subscriptions' },
  { y: 250, title: 'Resend', sub: 'Email and reminders' },
  { y: 314, title: 'Cloudinary', sub: 'Media' },
];
---
<figure class="diagram">
  <svg viewBox="0 0 520 430" role="img" aria-labelledby="dg-title dg-desc">
    <title id="dg-title">VendoraCRM system architecture</title>
    <desc id="dg-desc">Customers and business owners use a Vue.js frontend on Vercel, which calls a FastAPI REST API on Render. The API stores data in PostgreSQL and integrates Paystack for subscriptions, Resend for email and Cloudinary for media.</desc>
    <defs>
      <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
        <path d="M20 0H0V20" fill="none" stroke="#2A2F37" stroke-width="0.6" />
      </pattern>
      <marker id="arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 8 4 0 8z" fill="#5B8CFF" />
      </marker>
    </defs>
    <rect width="520" height="430" fill="url(#grid)" opacity=".7" />

    <g class="links">
      <path class="link" style="--d:0" d="M150 80V128" marker-end="url(#arrow)" />
      <path class="link" style="--d:1" d="M150 190V238" marker-end="url(#arrow)" />
      <path class="link" style="--d:2" d="M150 300V348" marker-end="url(#arrow)" />
      <path class="link svc" style="--d:3" d="M262 262H290V208H334" marker-end="url(#arrow)" />
      <path class="link svc" style="--d:3.4" d="M262 272H334" marker-end="url(#arrow)" />
      <path class="link svc" style="--d:3.8" d="M262 282H290V336H334" marker-end="url(#arrow)" />
    </g>

    {core.map((n, i) => (
      <g class="node" style={`--d:${i * 0.9}`}>
        <rect x="40" y={n.y} width="222" height="56" rx="4" class={n.key ? 'key' : ''} />
        <text x="56" y={n.y + 24} class="t">{n.title}</text>
        <text x="56" y={n.y + 42} class="s">{n.sub}</text>
      </g>
    ))}
    {services.map((n, i) => (
      <g class="node" style={`--d:${3.2 + i * 0.4}`}>
        <rect x="336" y={n.y} width="150" height="44" rx="4" class="svc-box" />
        <text x="350" y={n.y + 19} class="t">{n.title}</text>
        <text x="350" y={n.y + 35} class="s">{n.sub}</text>
      </g>
    ))}
  </svg>
  <figcaption>VendoraCRM in production: a system I designed, built and deployed.</figcaption>
</figure>

<style>
  .diagram { margin: 0; }
  svg { width: 100%; height: auto; border: 1px solid var(--line); border-radius: 6px; background: var(--panel); }
  rect:not([fill]) { fill: #16191d; stroke: var(--line-strong); stroke-width: 1; }
  rect.key { stroke: var(--accent); }
  rect.svc-box { stroke: color-mix(in srgb, var(--violet) 55%, var(--line-strong)); }
  .t { font: 600 13px var(--sans); fill: var(--text); }
  .s { font: 400 11.5px var(--sans); fill: var(--muted); }
  .link { fill: none; stroke: var(--accent); stroke-width: 1.4; stroke-dasharray: 200; stroke-dashoffset: 0; }
  .link.svc { stroke: var(--violet); }
  figcaption { margin-top: 0.8rem; font-size: var(--step--1); color: var(--faint); }

  @media (prefers-reduced-motion: no-preference) {
    .node { opacity: 0; animation: appear .5s ease-out forwards; animation-delay: calc(var(--d) * 0.22s + 0.15s); }
    .link { stroke-dashoffset: 200; animation: draw .6s ease-out forwards; animation-delay: calc(var(--d) * 0.22s + 0.4s); }
  }
  @keyframes appear { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
  @keyframes draw { to { stroke-dashoffset: 0; } }
</style>
