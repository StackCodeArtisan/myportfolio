---
import Brand from './Brand.astro';
import { person } from '../data/site.js';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap row">
    <p>© {year} {person.name}. Founder of {person.company}.</p>
    <ul>
      <li><a href={person.github} rel="noopener" target="_blank"><Brand name="github" size={16} /><span>GitHub</span></a></li>
      <li><a href={person.linkedin} rel="noopener" target="_blank"><Brand name="linkedin" size={16} /><span>LinkedIn</span></a></li>
      <li><a href={`mailto:${person.email}`}>Email</a></li>
    </ul>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--line); padding-block: 2rem; color: var(--faint); font-size: var(--step--1); }
  .row { display: flex; flex-wrap: wrap; gap: 1rem 2rem; align-items: center; justify-content: space-between; }
  p { margin: 0; }
  ul { display: flex; gap: 1.5rem; }
  a { display: inline-flex; gap: 0.45rem; align-items: center; text-decoration: none; color: var(--muted); }
  a:hover { color: var(--text); }
</style>
